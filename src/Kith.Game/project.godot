; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Kith — Godot view shell.
;
; This project is the RENDERER ONLY. All simulation lives in
; ../Kith.Sim, which has no Godot reference and is tested headlessly.
; Nothing in here may mutate sim state (DESIGN.md §3).
;
; ⛔ custom_user_dir_name keeps the folder the game had as bclone, so Joe's saves and settings
; stay where they were (D812, his call: "Keep the old folder name"). Without it, the name
; Kith would point Godot at a new, empty app_userdata\Kith.
;
; The editor rewrites this file and will delete the note above if it
; gets the chance — put it back.

config_version=5

[application]

config/name="Kith"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/bclone"
config/description="A generational village-builder. Phase 0: one villager, one resource loop."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Look="*res://LookLoader.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Kith.Game"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
