; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; bclone — Godot view shell.
;
; This project is the RENDERER ONLY. All simulation lives in
; ../Bclone.Sim, which has no Godot reference and is tested headlessly.
; Nothing in here may mutate sim state (DESIGN.md §3).

config_version=5

[application]

config/name="bclone"
config/description="A generational village-builder. Phase 0: one villager, one resource loop."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="Bclone.Game"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
