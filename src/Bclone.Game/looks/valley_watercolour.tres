[gd_resource type="Resource" script_class="ValleyWatercolourLook" load_steps=2 format=3]

; The valley's watercolour, on its way toward the concept art (`specs/terrain-shader.md §7`, A26-A27). Joe's art
; direction, A26: ink first, wash second. NOTHING HERE IS APPROVED YET: these are the first values, for his eyes.
; Ink (A28, Joe: "forests/wooded areas and ore seams shouldn't get ink outlines" ... "i want it to look like actual
; ink"): a warm sepia-black pen stroke on the river's bank only, constant on screen, swelling and thinning with the pen's
; pressure, lifting where it is lightest, its edge feathered into the paper.
; Trees: each crown laid on a disc of the same ink a little wider than itself, so the clumps are outlined.
; Pooling: the river's wash darker at its own edge, where watercolour pigment gathers as it dries.

[ext_resource type="Script" path="res://ValleyWatercolourLook.cs" id="1_look"]

[resource]
script = ExtResource("1_look")
InkColour = Color(0.227451, 0.176471, 0.12549, 1)
InkStrength = 0.9
InkWidthPx = 2.6
InkPressure = 0.65
InkPressureTiles = 2.5
InkLifts = 0.15
InkFeatherPx = 0.7
TreeInkTiles = 0.05
PoolStrength = 0.16
PoolWidthPx = 3.0
