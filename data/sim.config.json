{
  // ============================================================
  //  bclone — simulation config
  //
  //  Data-driven from day one (DESIGN.md §3): no tunable lives in
  //  code. Comments and trailing commas are permitted here —
  //  System.Text.Json is configured to allow both, so this file
  //  stays readable for modders without adding a dependency.
  // ============================================================

  // Seed for the whole run. Same seed + same config + same tick
  // count => byte-identical history. This is the determinism
  // contract (specs/tick-loop.md §1).
  "seed": 12345,

  // ---- The village ------------------------------------------
  // Four founding adults in two households, growing outward.
  "starting_households": 2,
  "adults_per_household": 2,
  "founder_age": 20,
  "household_spacing": 3,
  "adult_age": 15,
  "leave_home_age": 18,
  "max_household_size": 7,

  // Homes cluster in a spiral rather than a line, and the economy is
  // derived for the FURTHEST home a village this size will build - the
  // first version budgeted for household #1 and let every outlying
  // family starve.
  "economy_horizon_households": 20,

  // ---- Calendar ----------------------------------------------
  // 4 ticks/day x 15 days x 4 seasons = 240 ticks per year.
  // At 1 tick/sec that is 240 real seconds per in-game year at 1x,
  // and 60 seconds at 4x - the pace Joe asked for.
  // See specs/phase-0-vertical-slice.md §11 for the derivation.
  "ticks_per_day": 4,
  "days_per_season": 15,

  // ---- Playback only — NEVER read by sim logic ---------------
  // These control how fast the world is drawn, not what happens
  // in it. Changing them must not change sim outcomes; there is a
  // test that proves it (PlaybackSpeed_DoesNotAffectState).
  // Set so that ONE IN-GAME YEAR TAKES 60 REAL SECONDS AT 4x, which
  // is the intended watching speed. 240 ticks/year / (1.0 * 4) = 60s.
  // Playback only - this cannot change what happens in the sim.
  "target_ticks_per_second": 1.0,
  "max_ticks_per_frame": 250,

  // ---- Needs -------------------------------------------------
  // Hunger fills in 10 ticks and the villager eats at 80, so they
  // eat roughly every 2 days. That cadence is chosen to be READ
  // rather than calculated — you should be able to watch it.
  "hunger_per_tick": 10,
  "hunger_max": 100,
  "eat_threshold": 80,
  "eat_reduces_hunger": 80,
  "food_per_meal": 5,

  // 24 ticks = 6 days at maximum hunger before death. Boundary
  // is >= (decided in spec §11).
  "starvation_ticks": 24,

  // ---- Foraging ----------------------------------------------
  // DERIVED, not chosen. VillageEconomy states the target - one adult at
  // minimum vigour, with no partner, must feed themselves and three
  // children - and computes the yield it requires. A test asserts this
  // file still meets it, so editing hunger or travel without redoing
  // this fails the build rather than the village.
  //
  // The budget is the WORST walk in a village this size: for every home
  // it will plausibly build, how far is that home's own nearest site,
  // and which home has it worst. Both halves are load-bearing - deriving
  // from the first home starved the outskirts, and deriving from the
  // last home (which happens to sit beside a thicket) assumed everybody
  // had a one-tile commute and starved the whole village.
  // Re-derived when the valley became generated (D18): the canonical ring of sites
  // plus the worst jitter the generator may add is a longer walk than the
  // hand-placed layout was, so a trip has to bring back more. 60 -> 86.
  "gather_yield": 86,
  "gather_ticks": 3,
  "travel_ticks_per_unit": 1,

  // Also DERIVED: enough to carry one member through a foraging-less
  // winter, plus the margin that absorbs a worker dying part-way
  // through one. Per member, not per household.
  "stockpile_target": 67,

  // ---- The valley --------------------------------------------
  // Wide rather than square: the terrain DESIGN.md §2.5 describes is
  // a river valley, and the river runs along it rather than across.
  //
  // Nothing in the sim reads these yet - they bound the camera and give
  // the drawn ground an edge, so a mostly-empty map reads as a valley
  // with room to grow rather than as a bug. They live here because the
  // MAP GENERATOR will need them (D18): terrain, water, forest stands
  // and forage sites all get generated into these bounds from the run's
  // seed, at which point this stops being a drawing hint and becomes
  // world state.
  "map_width": 120,
  "map_height": 80,

  // Where the village is founded, as an OFFSET from the spot the map
  // generator chose for it (D18). It used to be an absolute coordinate;
  // the valley is generated now, so the settlement is wherever the
  // generator put it and every building hangs off this.
  "home_x": 0,
  "home_y": 0,

  // ---- The valley, generated (D18) ---------------------------
  // These replaced the literal coordinates the world used to be typed
  // in as. A modder controls the RULES of a valley - how many sites,
  // how far out, how wide the river - rather than the outcome, which
  // is the honest data-driven form once the world is generated.
  //
  // Several places to forage is structural, not scenery (D19): a
  // catchment radius that actually BINDS kills outlying households when
  // there is only one food source, because those families have nothing
  // within reach to work. And they have to be SPREAD (D24) - the first
  // hand-placed attempt put them all out at the edges, which left every
  // home near the middle competing for the one original patch, so
  // tightening catchment just left people idle beside a full patch and
  // their households starved. The generator guarantees the spread by
  // construction: evenly spaced slots with jitter, never free angles.
  "forage_site_count": 6,
  "forage_site_ring_tiles": 5,
  "tree_stand_count": 2,
  "tree_stand_ring_tiles": 4,
  "tree_stand_radius_tiles": 3,

  // EVERY TILE OF THIS IS PAID FOR BY THE WHOLE ECONOMY. The food
  // budget assumes the worst case - a site jittered directly away from
  // the home that needs it, costing twice this in Manhattan distance -
  // so generosity here makes every villager in every valley work
  // harder, including on the seeds where the sites land close. One tile
  // buys visibly different valleys; two pushed the required gather
  // yield up by two thirds.
  "site_jitter_tiles": 1,
  "founding_jitter_tiles": 2,

  // Water is generated but NOTHING READS IT YET, and that sequencing is
  // deliberate (D40). Making the river impassable means real
  // pathfinding in the travel-cost field - the field that decides
  // labour catchment, market errands and the economy's distance budget
  // - so it is its own slice. Crossing water will need a bridge, which
  // is a technology first and a building second.
  "river_width_tiles": 2,

  // Reserved for soil depletion (DESIGN.md §2.3). Generated and hashed,
  // read by nothing - it is here so that when depletion lands it does
  // not have to change the generator's DRAW ORDER, which would
  // invalidate every seed anyone had written down.
  "soil_quality_min": 40,
  "soil_quality_max": 200,

  // How many hands fit at one patch, and how far it is reasonable to
  // walk to work. Capacity is a LOCAL fact about a place; how many
  // foragers the village needs is a village-level question and lives in
  // LabourQuota. Conflating the two is what specs/labour-allocation.md
  // §3 is a record of.
  //
  // Ten tiles, lowered from twelve now the sites are spread properly:
  // at twelve a home in the middle could reach nearly everything, so the
  // rule constrained nothing.
  "forage_site_capacity": 4,
  "forager_catchment_tiles": 10,

  // The village shares out all its work again once a year, so people
  // drift toward the jobs nearest where they live (decision D20).
  // Seasonal churn would make the stated reason for holding a job go
  // stale before anyone read it.
  "labour_reshuffle_years": 1,

  // ---- Ageing ------------------------------------------------
  // Full strength until 30, then a straight decline to 55% in the
  // final year. This is the only source of year-to-year variation in
  // Phase 0, and it is what gives a life a shape: easy middle years
  // with time to rest, then a long tightening where the same food
  // costs more and more walking.
  "vigour_full_until_age": 30,
  "vigour_min_percent": 55,

  // ---- Life --------------------------------------------------
  // 45 +/- 5 => 40-50 year lives. At 60s per year on 4x, that is a
  // 40-50 minute life: long enough to be a life rather than a demo.
  "lifespan_years_base": 45,
  "lifespan_years_variance": 5,

  // ---- Timber (decision D17) ---------------------------------
  // Cuttable year-round, unlike berries, so a woodcutter still works
  // in winter. Nobody is spared for the stand while a household in the
  // village is going hungry - the village feeds itself before it
  // builds, and that is the whole labour policy in one sentence.
  // Where the stands are is generator output now - see
  // tree_stand_count and tree_stand_ring_tiles above.
  "cut_yield": 12,
  "cut_ticks": 4,
  "tree_stand_capacity": 3,

  // A home has to be built, out of LOGS. Wood is two resources now
  // (D29): a logger fells logs, a woodcutter turns logs into firewood,
  // and firewood is what a household burns in winter. Logs build; only
  // firewood heats. Drawn from the whole village, parents first.
  "logs_per_house": 30,

  // ---- Firewood (decision D29) -------------------------------
  // The first workplace that CONSUMES an input rather than only
  // producing one. It can stand idle for want of logs, which is a state
  // no other workplace can be in - so a woodcutter with an empty yard
  // says so rather than mysteriously going home.
  //
  // Near the homes rather than near the stand: logs are drawn
  // village-wide, so the only distance that costs anything is the
  // woodcutter's daily walk from home.
  "woodcutter_hut_x": -2,
  "woodcutter_hut_y": 1,
  "woodcutter_hut_capacity": 3,
  "logs_per_split": 6,
  "split_ticks": 4,

  // DERIVED, like gather_yield. The stated target: heating every home
  // through winter must cost no more than HALF the hands the village can
  // spare once everyone is fed. The half is the margin, and it is the
  // same argument D16 makes about the third dependant - solving for
  // "exactly affordable" produces a village that is warm by construction
  // with nobody left to build and no slack for a long winter, which is
  // useless the moment anything pushes on it.
  // Also re-derived for the generated valley: the stand sits on its own ring now and
  // the haul to the shed is costed against it, so fewer trips fit in a year and each
  // batch has to be bigger to heat the same homes. 36 -> 141.
  "firewood_per_split": 141,

  // Per household, not per member: a house costs the same to heat
  // whether two live in it or five. That makes SPRAWL the thing that
  // costs rather than population - a pressure that traces back to a
  // player decision (DESIGN.md §2.3).
  "firewood_per_winter_day": 1,

  // Longer than starvation_ticks on purpose: firewood comes from a
  // two-step chain and food from a one-step one, so the village needs
  // time to notice and put hands back on the hut. A cold snap that
  // killed as fast as famine would give nobody a chance to respond,
  // which is the difference between pressure and a coin flip.
  "freezing_ticks": 40,

  // ---- Storage (D30, D32) ------------------------------------
  // Two buildings, not one. Food spoils and timber does not, and one
  // undifferentiated village pile would delete the per-household
  // inequality D14 exists to create - "one family starving beside a
  // thriving neighbour" is the story per-household food was introduced
  // for. Keeping them apart changes what inequality is MADE of: not
  // whose larder it is, but who is near the granary and who has hands
  // to send.
  //
  // Both sit near the homes and exist from the founding. When building
  // placement lands, WHERE the granary goes becomes the first decision
  // in the game that storage makes interesting.
  "granary_x": 1,
  "granary_y": -1,
  "storage_shed_x": -2,
  "storage_shed_y": 0,

  // What one person can carry in one trip. This is the whole reason a
  // fetch is a journey rather than a teleport with extra steps: an
  // armful at a time is what makes the distance to the granary cost
  // something, which is where D32 said the interesting inequality would
  // live. Raise it far enough and storage becomes bookkeeping again.
  "carry_capacity": 40,

  // HOW BIG THE VILLAGE CAN GET, stated as a fact about a building (D33).
  //
  // A granary holds a winter's store for this many people; VillageEconomy
  // derives the quantity from it, and derives the population ceiling from
  // that. Births are gated on the granary holding a share of what everyone
  // alive would want, so once the village outgrows what the building can
  // hold, it stops growing. That is the whole mechanism, and it is what
  // makes the population hold a flat line instead of overshooting and
  // falling back: measured over 200 years, 24-35 people here against
  // 24-86 with the cap removed.
  //
  // A number about the BUILDING, like how many hands fit at a berry patch -
  // which is why it is here rather than derived. What is NOT typed in is the
  // consequence. When placement lands, the player answers this by building a
  // second granary; until then it is this line.
  "granary_feeds_people": 30,

  // ---- The market (D14, D36) ---------------------------------
  // Among the homes, which is the whole of its value: it is the
  // short walk. The one building that is both a store and a
  // workplace, because its contents arrive by somebody's work
  // rather than by producers dropping things off.
  "market_x": 2,
  "market_y": 1,

  // More than one trader - a market is a place several people work.
  // ZERO SWITCHES IT OFF, and that is a supported state with a test
  // on it: households still fetch for themselves, so an unstaffed
  // market means longer walks and stranded goods, never a family
  // that cannot eat. The moment that stops being true, the market
  // has become the cliff fetching was designed to avoid.
  "market_capacity": 2,

  // What the market keeps on hand, per household the village is
  // budgeted for. A market is a short trip, not a second granary -
  // sized flat it would become the real store as the village grew,
  // re-centralising everything storage just spread out.
  "market_stock_per_household": 40,

  "villager_names": [
    "Mabel", "Otto", "Bess", "Silas",
    "Agnes", "Wendell", "Hattie", "Amos",
  ],
}
